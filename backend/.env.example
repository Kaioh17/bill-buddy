# Copy to .env and fill in. .env is gitignored, never commit it.

# dev: readable console logs, DEBUG for app code.
# prod: one JSON object per line on stderr, INFO and up.
APP_ENV=dev
# Optional override: DEBUG, INFO, WARNING or ERROR. Leave unset to use the APP_ENV default.
LOG_LEVEL=

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/billbuddy
# Local dev without Postgres: sqlite+aiosqlite:///./billbuddy.db

# Comma separated list of exact origins allowed to call the API from a browser.
# No "*" (rejected on startup). In prod use your real https frontend URL(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Signs access tokens. Required, at least 32 random characters, different per environment.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-random-value
JWT_ALGORITHM=HS256
# Minutes of inactivity before the user must log in again (token is renewed on every request).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Hard cap on one session in hours, however active the user is.
SESSION_MAX_HOURS=12
