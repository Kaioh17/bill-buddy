# Base URL of the FastAPI backend. Its CORS_ORIGINS must include this app's origin.
VITE_API_URL=http://localhost:8000

# true: sample data and a local sign-in, no backend needed. Only works in `npm run dev`.
# Sign in with any email and password. An email starting with `empty` shows a new account,
# `error` makes data requests fail, `slow` delays them.
VITE_USE_MOCKS=false
